    <owl:Class rdf:about="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#FiniteElementModel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#NumericalModel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
