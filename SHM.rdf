                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#ExtractedData"/>
                            <rdf:Description rdf:about="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#RawData"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
