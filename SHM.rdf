    <!-- http://purl.obolibrary.org/obo/IAO_0000111#Model -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/IAO_0000111#Model"/>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#AEPeakAmplitudeMonitoring -->

    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#AEPeakAmplitudeMonitoring">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#AcousticEmissionMonitoring"/>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#AbsoluteSignalDifference -->

    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#AbsoluteSignalDifference">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#GuidedWaveApproach"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#computesDuringNormalConditions"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#Diagram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#computesDuringTestingConditions"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#Diagram"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#computesBetweenActuatorOutputAndReceiverInput"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.co-ode.org/ontologies/ont.owl#AbsoluteDifferenceBetweenInputAndOutput"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#AccelerationSimulationData -->

    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#AccelerationSimulationData">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#SimulationData"/>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Accelerogram -->

    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Accelerogram">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#Diagram"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#canBeGeneratedByTransformationOfDisplacementGraph"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.co-ode.org/ontologies/ont.owl#DisplacementGraph"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#canBeGeneratedByTransformationOfVelocityGraph"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.co-ode.org/ontologies/ont.owl#VelocityGraph"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Accelerometer -->

    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Accelerometer">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#StructureSensor"/>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#AcousticEmissionMonitoring -->

    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#AcousticEmissionMonitoring">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#SHMmethod"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#hasAEThreshold"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.co-ode.org/ontologies/ont.owl#AcousticEmisionsThreshold"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Actuator -->

    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Actuator">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#PhysicalTwin"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#canProduceWavesFor"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#GuidedWaveApproach"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#producesWavesTo"/>
                <owl:someValuesFrom rdf:resource="http://www.co-ode.org/ontologies/ont.owl#GuidedWaveSensor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.co-ode.org/ontologies/ont.owl#Anemometer -->

    <owl:Class rdf:about="http://www.co-ode.org/ontologies/ont.owl#Anemometer">
        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#LoadingMeter"/>
