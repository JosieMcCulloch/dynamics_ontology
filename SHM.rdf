    <!-- http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#FEM_model_usages -->

    <rdfs:Datatype rdf:about="http://www.semanticweb.org/me1gtx/ontologies/2018/10/untitled-ontology-35#FEM_model_usages">
        <owl:equivalentClass>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
