        <rdfs:subClassOf rdf:resource="http://www.co-ode.org/ontologies/ont.owl#RegressionArtificialNeuralNetwork"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.co-ode.org/ontologies/ont.owl#hasInputsEqualToItsOutputs"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


